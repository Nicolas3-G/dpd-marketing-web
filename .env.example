# EmailJS (https://www.emailjs.com/) — server-side contact form.
# Copy to `.env.local` (or `.env`) and restart `npm run dev`.
#
# Account → API keys: Public Key + Private Key
# Email Services → Service ID
# Email Templates → Template ID
#
# Template variables:
#   {{from_name}} {{email}} {{first_name}} {{last_name}}
#   {{job_title}} {{phone}} {{company}}

EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
