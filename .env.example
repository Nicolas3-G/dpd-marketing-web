# Resend (https://resend.com) — server-side contact form.
# Copy to `.env.local` and restart `npm run dev`.
#
# RESEND_API_KEY:    Dashboard → API Keys
# RESEND_FROM_EMAIL: Verified sender, e.g. "DPD <contact@dpdframework.com>"
# RESEND_TO_EMAIL:   Where contact submissions are delivered

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=DPD Contact Form <contact@dpdframework.com>
RESEND_TO_EMAIL=hello@dpding.com
